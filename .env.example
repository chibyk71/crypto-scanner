# =============================================================================
# .env.example – Copy to .env and fill in your secrets
# Source of truth: src/lib/config/settings.ts (ConfigSchema)
# =============================================================================

# ──────────────────────────────────────────────────────────────
# Core Environment
# ──────────────────────────────────────────────────────────────
ENV=dev                          # dev | test | prod
LOG_LEVEL=info                   # error | warn | info | debug

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
DATABASE_URL=file:local.db
# Example for Turso:
# DATABASE_URL=libsql://your-db-name-yourusername.turso.io?authToken=your-auth-token

# ──────────────────────────────────────────────────────────────
# Exchange & Trading Mode
# ──────────────────────────────────────────────────────────────
EXCHANGE=bybit                   # bybit | gate | binance
EXCHANGE_API_KEY=                # Live trading key (leave blank for read-only)
EXCHANGE_API_SECRET=             # Live trading secret
EXCHANGE_TESTNET=false           # Schema default: false

# Master kill-switch for live trading (schema key: AUTO_TRADE_ENABLED)
AUTO_TRADE_ENABLED=true
# Optional: fixed USD size per trade (overrides percent sizing when set)
# FIXED_TRADE_USD=100

# ──────────────────────────────────────────────────────────────
# Telegram Notifications
# ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABCdefGhIJKlmnoPQRstuvWXyz
TELEGRAM_CHAT_ID=-1001234567890

# ──────────────────────────────────────────────────────────────
# Symbols & Timeframes
# ──────────────────────────────────────────────────────────────
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=3m                     # Primary scanner candles (schema default)
TIMEFRAME_SIMULATION=1m          # Simulation / excursion candles
HTF_TIMEFRAME=15m                # Higher timeframe (schema default; eval harness assumes 3m/15m ratio 5)

# ──────────────────────────────────────────────────────────────
# Scanner Behavior
# ──────────────────────────────────────────────────────────────
SCAN_INTERVAL_MS=300000
HEARTBEAT_INTERVAL=120
HISTORY_LENGTH=300

# ──────────────────────────────────────────────────────────────
# Risk Management & Position Sizing
# ──────────────────────────────────────────────────────────────
ATR_MULTIPLIER=1.5
RISK_REWARD_TARGET=3.0
TRAIL_ACTIVATION_PCT=0.2         # % favorable move before trailing arms
TRAIL_GIVEBACK_PCT=0.10          # Giveback distance (%) once armed
POSITION_SIZE_PERCENT=1.0
LEVERAGE=5

# ──────────────────────────────────────────────────────────────
# Regime-aware & Reversal Controls
# ──────────────────────────────────────────────────────────────
AUTO_TRADE_REVERSAL_ENABLED=false
RECENT_WINDOW_HOURS=3
MIN_RECENT_SAMPLES_FOR_ADJUSTMENT=1
MIN_REVERSE_COUNT_FOR_AUTO_REVERSAL=3

# ──────────────────────────────────────────────────────────────
# 5-Tier ML Labeling Thresholds (R-multiple based)
# ──────────────────────────────────────────────────────────────
ML_LABEL_STRONG_WIN=3.0
ML_LABEL_GOOD_WIN=1.5
ML_LABEL_BREAK_EVEN=-0.5
ML_LABEL_SMALL_LOSS=-1.5

# ──────────────────────────────────────────────────────────────
# Simulation Engine
# ──────────────────────────────────────────────────────────────
SIMULATION_TIMEOUT_MINUTES=10
SIMULATION_POLL_INTERVAL_MS=60000
SIMULATION_DEFAULT_RISK_PCT=1.5

# ──────────────────────────────────────────────────────────────
# Partial Take-Profit Levels (R-multiple based)
# Format: "R:weight,R:weight" → weight must sum ≤ 1.0
# ──────────────────────────────────────────────────────────────
PARTIAL_TP_LEVELS=1.5:0.4,3.0:0.3,6.0:0.3

# ──────────────────────────────────────────────────────────────
# Fixed Profit Target & ATR Feasibility Gate
# ──────────────────────────────────────────────────────────────
TARGET_PROFIT_PCT=0.3
MIN_ACCEPTABLE_RR=1.0

# ──────────────────────────────────────────────────────────────
# Machine Learning
# ──────────────────────────────────────────────────────────────
MIN_SAMPLES_TO_TRAIN=150
MODEL_PATH=./models/model.onnx
TRAINING_MODE=true
# Optional — defaults next to MODEL_PATH if unset
MODEL_BUY_PATH=./models/model-buy.onnx
MODEL_SELL_PATH=./models/model-sell.onnx

# ──────────────────────────────────────────────────────────────
# Confidence & Market Filters
# ──────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=35
MIN_ADX_TREND=20
MIN_DI_DIFF_TREND=15
MIN_ATR_PCT=0.12
MAX_ATR_PCT=20
MIN_BB_BANDWIDTH_PCT=0.5
MIN_AVG_VOLUME_USD_PER_HOUR=500

# ──────────────────────────────────────────────────────────────
# Excursion-Based Strategy Adjustments
# ──────────────────────────────────────────────────────────────
MAX_MAE_PCT=2.0
MIN_EXCURSION_RATIO=1.5
EXCURSION_CONFIDENCE_BOOST=0.1

# ──────────────────────────────────────────────────────────────
# Worker & Locking
# ──────────────────────────────────────────────────────────────
LOCK_TYPE=database               # database | file
SCANNER_MODE=periodic            # periodic | single

# Optional proxy for HTTP requests
# HTTPS_PROXY_URL=
